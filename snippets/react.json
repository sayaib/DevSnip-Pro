  "DevSnip: React custom hook": {
    "prefix": "ds-hook",
    "description": "A custom hook that fetches JSON, cancels on unmount and exposes loading and error state.",
    "body": [
      "import { useEffect, useState } from \"react\";",
      "",
      "export function use${1:Data}<T>(url: string) {",
      "  const [data, setData] = useState<T>();",
      "  const [error, setError] = useState<Error>();",
      "  const [loading, setLoading] = useState(true);",
      "",
      "  useEffect(() => {",
      "    const controller = new AbortController();",
      "    setLoading(true);",
      "    fetch(url, { signal: controller.signal })",
      "      .then(response => {",
      "        if (!response.ok) throw new Error(`HTTP \\${response.status}`);",
      "        return response.json() as Promise<T>;",
      "      })",
      "      .then(setData)",
      "      .catch((reason: unknown) => {",
      "        if (!controller.signal.aborted) setError(reason instanceof Error ? reason : new Error(String(reason)));",
      "      })",
      "      .finally(() => {",
      "        if (!controller.signal.aborted) setLoading(false);",
      "      });",
      "    return () => controller.abort();",
      "  }, [url]);",
      "",
      "  return { data, error, loading };",
      "}",
      "$0"
    ]
  },
  "DevSnip: React context": {
    "prefix": "ds-context",
    "description": "A typed context, its provider and a hook that fails loudly outside the provider.",
    "body": [
      "import { createContext, useContext, useMemo, useState, type ReactNode } from \"react\";",
      "",
      "interface ${1:Theme}ContextValue {",
      "  ${2:value}: string;",
      "  ${4:setValue}: (next: string) => void;",
      "}",
      "",
      "const ${1:Theme}Context = createContext<${1:Theme}ContextValue | null>(null);",
      "",
      "export function ${1:Theme}Provider({ children }: { children: ReactNode }) {",
      "  const [${2:value}, ${4:setValue}] = useState(\"${3:initial}\");",
      "  const context = useMemo(() => ({ ${2:value}, ${4:setValue} }), [${2:value}]);",
      "  return <${1:Theme}Context.Provider value={context}>{children}</${1:Theme}Context.Provider>;",
      "}",
      "",
      "export function use${1:Theme}() {",
      "  const context = useContext(${1:Theme}Context);",
      "  if (!context) throw new Error(\"use${1:Theme} must be used inside <${1:Theme}Provider>\");",
      "  return context;",
      "}",
      "$0"
    ]
  },
