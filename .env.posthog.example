# PostHog credentials for DevSnip Pro.
# Copy this file to .env.posthog (git-ignored, never packaged) and fill it in.
# Environment variables of the same name override these values (e.g. CI secrets).

# Project API key - PostHog > Project settings > Project API key. Starts with phc_.
# This is the only credential built into the extension (write-only: it can send events, not read them).
POSTHOG_PROJECT_API_KEY=phc_...
# Ingestion host: https://eu.i.posthog.com (EU cloud) or https://us.i.posthog.com (US cloud).
POSTHOG_HOST=https://eu.i.posthog.com

# --- Only for `node scripts/posthog-dashboard.js` (never shipped in the extension) ---
# Personal API key - PostHog > Account settings > Personal API keys, scopes dashboard:write and insight:write. Starts with phx_.
POSTHOG_PERSONAL_API_KEY=phx_...
# Project ID - the number in the PostHog URL: .../project/<ID>/...
POSTHOG_PROJECT_ID=12345
# App host: https://eu.posthog.com (EU cloud) or https://us.posthog.com (US cloud).
POSTHOG_APP_HOST=https://eu.posthog.com
