    "configuration": {
      "title": "DevSnip Pro",
      "properties": {
        "devsnip.apiTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Default request timeout in milliseconds for the REST API Client. A per-request timeout set in the client overrides this."
        },
        "devsnip.consoleLogCleanup.confirmBeforeDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before removing console.log statements. Turn this off to remove them immediately."
        },
        "devsnip.securityAudit.maxFiles": {
          "type": "number",
          "default": 2000,
          "minimum": 50,
          "maximum": 20000,
          "description": "Maximum number of files each security or cloud configuration audit reads."
        },
        "devsnip.premium.licensePortalUrl": {
          "type": "string",
          "default": "",
          "description": "URL opened by the Unlock Premium action. Leave empty to use the in-editor licence key prompt."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myActivityBar",
          "title": "DevSnip Pro",
          "icon": "nav_icon.png"
        }
      ]
    },
    "views": {
      "myActivityBar": [
        {
          "id": "myView",
          "name": "Tools"
        }
      ]
    },
    "submenus": [
      {
        "id": "devsnip.editorContext",
        "label": "DevSnip Pro"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "devsnip.editorContext",
          "group": "1_modification@100"
        }
      ],
      "devsnip.editorContext": [
        {
          "command": "sayaib.hue-console.createCustomSnippet",
          "group": "1_snippets@1",
          "when": "editorHasSelection"
        },
        {
          "command": "sayaib.hue-console.jsonFormatter",
          "group": "2_tools@1"
        },
        {
          "command": "sayaib.hue-console.listAndRemoveConsoleLogs",
          "group": "2_tools@2"
        },
        {
          "command": "sayaib.hue-console.removeUnusedImports",
          "group": "2_tools@3"
        },
        {
          "command": "sayaib.hue-console.observabilityAnalyze",
          "group": "2_tools@4"
        },
        {
          "command": "sayaib.hue-console.searchTools",
          "group": "3_search@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sayaib.hue-console.setDevelopmentTier",
          "when": "isDevelopment"
        },
        {
          "command": "sayaib.hue-console.resetFeatureUsage",
          "when": "isDevelopment"
        }
      ]
    }
  },
  "activationEvents": [
    "onView:myView"
  ],
  "main": "./out/extention.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "test:unit": "node ./out/test/unit/run-unit-tests.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.2.2",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^7.27.0",
    "glob": "^7.1.7",
    "mocha": "^12.0.1",
    "typescript": "^4.3.2"
  },
  "dependencies": {
    "axios": "^1.8.3"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DevSnip Pro scans workspace files and can run npm and OpenCode commands, so it requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Tools that spawn processes (OpenCode Integration) are unavailable in virtual workspaces."
    }
  }
}
