    ],
    "configuration": {
      "title": "DevSnip Pro",
      "properties": {
        "devsnip.apiTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Default request timeout in milliseconds for the REST API Client. A per-request timeout set in the client overrides this."
        },
        "devsnip.consoleLogCleanup.confirmBeforeDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before removing console.log statements. Turn this off to remove them immediately."
        },
        "devsnip.securityAudit.maxFiles": {
          "type": "number",
          "default": 2000,
          "minimum": 50,
          "maximum": 20000,
          "description": "Maximum number of files each workspace, cloud or dependency security scan reads."
        },
        "devsnip.security.endpointTimeout": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "Default per-request timeout, in milliseconds, for the endpoint security scanner."
        },
        "devsnip.analytics.enabled": {
          "type": "boolean",
          "default": true,
          "tags": [
            "telemetry",
            "usage"
          ],
          "markdownDescription": "Send anonymous usage analytics (which DevSnip Pro tools are opened and used, and a once-a-day active ping, under one anonymous id per computer) to help improve the extension. No code, file contents or names, paths, keystrokes, tool input or output, URLs, credentials or personal data are ever sent. Also respects VS Code's `#telemetry.telemetryLevel#`: nothing is sent unless it is `all`. See docs/ANALYTICS.md."
        },
        "devsnip.analytics.debug": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log every analytics event, exactly as sent, to the **DevSnip Pro: Analytics** output channel."
        },
        "devsnip.rewards.notifications": {
          "type": "string",
          "enum": [
            "all",
            "levelsOnly",
            "off"
          ],
          "enumDescriptions": [
            "Notify for rank-ups, unlocked rewards, milestones, finished quests, streak freezes and the weekly recap.",
            "Notify only for rank-ups and unlocked rewards.",
            "Never show progress notifications. The Milestones & Points page still shows everything."
          ],
          "default": "all",
          "markdownDescription": "Which DevSnip Pro progress notifications to show. Notifications are skipped while the **Milestones & Points** page is open, because it shows its own."
        },
        "devsnip.security.activeChecks": {
          "type": "boolean",
          "default": false,
          "description": "Pre-enable the endpoint scanner's active checks (reflected-input probe and requests for well-known sensitive paths). They are read-only but generate extra traffic, so they are opt-in by default."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myActivityBar",
          "title": "DevSnip Pro",
          "icon": "nav_icon.png"
        }
      ]
    },
    "views": {
      "myActivityBar": [
        {
          "type": "webview",
          "id": "myView",
          "name": "Tools"
        }
      ]
    },
    "submenus": [
      {
        "id": "devsnip.editorContext",
        "label": "DevSnip Pro"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "devsnip.editorContext",
          "group": "1_modification@100"
        }
      ],
      "devsnip.editorContext": [
        {
          "command": "sayaib.hue-console.createCustomSnippet",
          "group": "1_snippets@1",
          "when": "editorHasSelection"
        },
        {
          "command": "sayaib.hue-console.jsonFormatter",
          "group": "2_tools@1"
        },
        {
          "command": "sayaib.hue-console.listAndRemoveConsoleLogs",
          "group": "2_tools@2"
        },
        {
          "command": "sayaib.hue-console.removeUnusedImports",
          "group": "2_tools@3"
        },
        {
          "command": "sayaib.hue-console.observabilityAnalyze",
          "group": "2_tools@4"
        },
        {
          "command": "sayaib.hue-console.base64Encoder",
          "group": "2_tools@5",
          "when": "editorHasSelection"
        },
        {
          "command": "sayaib.hue-console.jwtDecoder",
          "group": "2_tools@6",
          "when": "editorHasSelection"
        },
        {
          "command": "sayaib.hue-console.yamlJsonTool",
          "group": "2_tools@7",
          "when": "editorLangId =~ /^(yaml|json|jsonc|dockercompose)$/"
        },
        {
          "command": "sayaib.hue-console.jsonToTypes",
          "group": "2_tools@8",
          "when": "editorLangId =~ /^(json|jsonc)$/"
        },
        {
          "command": "sayaib.hue-console.sparkSqlFormatter",
          "group": "2_tools@9",
          "when": "editorLangId == sql"
        },
        {
          "command": "sayaib.hue-console.dockerfileHelper",
          "group": "2_tools@10",
          "when": "editorLangId == dockerfile"
        },
        {
          "command": "sayaib.hue-console.envChecker",
          "group": "2_tools@11",
          "when": "resourceFilename =~ /^\\.env/"
        },
        {
          "command": "sayaib.hue-console.curlConverter",
          "group": "2_tools@12",
          "when": "editorHasSelection"
        },
        {
          "command": "sayaib.hue-console.htmlToJsx",
          "group": "2_tools@13",
          "when": "editorHasSelection && editorLangId =~ /^(html|javascriptreact|typescriptreact|vue|svg|xml)$/"
        },
        {
          "command": "sayaib.hue-console.buildErrorExplainer",
          "group": "2_tools@14",
          "when": "editorLangId =~ /^(log|plaintext|Log)$/"
        },
        {
          "command": "sayaib.hue-console.searchTools",
          "group": "3_search@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sayaib.hue-console.resetFeatureUsage",
          "when": "isDevelopment"
        },
        {
          "command": "sayaib.hue-console.webDevHub",
          "when": "false"
        },
        {
          "command": "sayaib.hue-console.mobileDevHub",
          "when": "false"
        },
        {
          "command": "sayaib.hue-console.aiMlHub",
          "when": "false"
        },
        {
          "command": "sayaib.hue-console.ragHub",
          "when": "false"
        },
        {
          "command": "sayaib.hue-console.bigDataHub",
          "when": "false"
        },
        {
          "command": "sayaib.hue-console.devopsGenerator",
          "when": "false"
        },
        {
          "command": "sayaib.hue-console.colorPalette",
          "when": "false"
        },
        {
          "command": "sayaib.hue-console.regexBuilder",
          "when": "false"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "devsnip.getStarted",
        "title": "Get started with DevSnip Pro",
        "description": "API requests, AI tools, security scans and databases, in five minutes.",
        "steps": [
          {
            "id": "tools",
            "title": "Find any tool in seconds",
            "description": "Every tool lives in the DevSnip Pro sidebar, grouped into 13 sections. Search with Ctrl/Cmd+K and star the ones you use.\n[Open the Tools sidebar](command:workbench.view.extension.myActivityBar)",
            "media": {
              "markdown": "media/walkthrough/tools.md"
            },
            "completionEvents": [
              "onView:myView"
            ]
          },
          {
            "id": "api",
            "title": "Send your first API request",
            "description": "The REST API Client sends HTTP, GraphQL and WebSocket requests with environments, collections and history - without leaving the editor.\n[Open the REST API Client](command:sayaib.hue-console.openGUI)",
            "media": {
              "markdown": "media/walkthrough/api.md"
            },
            "completionEvents": [
              "onCommand:sayaib.hue-console.openGUI"
            ]
          },
          {
            "id": "ai",
            "title": "Try the AI & LLM tools",
            "description": "Count tokens and compare model costs, build prompts, validate LLM JSON output and plan RAG pipelines. They run locally.\n[Browse the AI & ML tools](command:sayaib.hue-console.aiMlHub)",
            "media": {
              "markdown": "media/walkthrough/ai.md"
            },
            "completionEvents": [
              "onCommand:sayaib.hue-console.aiMlHub"
            ]
          },
          {
            "id": "security",
            "title": "Run a security scan",
            "description": "Audit the workspace for hard-coded secrets and unsafe code, check cloud configuration and dependencies, or scan an endpoint you own.\n[Open Security](command:sayaib.hue-console.securityHub)",
            "media": {
              "markdown": "media/walkthrough/security.md"
            },
            "completionEvents": [
              "onCommand:sayaib.hue-console.securityHub"
            ]
          },
          {
            "id": "database",
            "title": "Connect a database",
            "description": "Paste a connection string for PostgreSQL, MySQL, SQL Server, SQLite, MongoDB or Redis to browse and edit data and run queries.\n[Open the Database Client](command:sayaib.hue-console.databaseClient)",
            "media": {
              "markdown": "media/walkthrough/database.md"
            },
            "completionEvents": [
              "onCommand:sayaib.hue-console.databaseClient"
            ]
          },
          {
            "id": "theme",
            "title": "Make it yours",
            "description": "Preview twelve appearance themes for every DevSnip Pro panel, from Dracula to Aurora, and unlock them with the points you earn.\n[Choose a theme](command:sayaib.hue-console.chooseTheme)",
            "media": {
              "markdown": "media/walkthrough/theme.md"
            },
            "completionEvents": [
              "onCommand:sayaib.hue-console.chooseTheme"
            ]
          },
          {
            "id": "points",
            "title": "Track your progress",
            "description": "Earn points as you use DevSnip Pro, keep a streak and unlock milestones. Points pay for premium REST client tools.\n[Open Milestones & Points](command:sayaib.hue-console.milestoneTracker)",
            "media": {
              "markdown": "media/walkthrough/points.md"
            },
            "completionEvents": [
              "onCommand:sayaib.hue-console.milestoneTracker"
            ]
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onView:myView"
  ],
  "main": "./out/extention.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "compile:dev": "tsc -p ./ --incremental --tsBuildInfoFile .tsbuildinfo",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "test:unit": "node ./out/test/unit/run-unit-tests.js",
    "package": "vsce package",
    "vscode:prepublish": "node scripts/write-analytics-config.js && npm run compile"
  },
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.2.2",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^7.27.0",
    "glob": "^7.1.7",
    "mocha": "^12.0.1",
    "typescript": "^4.3.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "axios": "^1.8.3",
    "ioredis": "^5.11.1",
    "mongodb": "^6.21.0",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "sql.js": "^1.14.2",
    "yaml": "^2.9.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DevSnip Pro scans workspace files and can run npm and OpenCode commands, so it requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Tools that spawn processes (OpenCode Integration) are unavailable in virtual workspaces."
    }
  }
}
