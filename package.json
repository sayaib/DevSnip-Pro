        "id": "devsnip.editorContext",
        "label": "DevSnip Pro"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "devsnip.editorContext",
          "group": "1_modification@100"
        }
      ],
      "devsnip.editorContext": [
        {
          "command": "sayaib.hue-console.createCustomSnippet",
          "group": "1_snippets@1",
          "when": "editorHasSelection"
        },
        {
          "command": "sayaib.hue-console.jsonFormatter",
          "group": "2_tools@1"
        },
        {
          "command": "sayaib.hue-console.listAndRemoveConsoleLogs",
          "group": "2_tools@2"
        },
        {
          "command": "sayaib.hue-console.removeUnusedImports",
          "group": "2_tools@3"
        },
        {
          "command": "sayaib.hue-console.observabilityAnalyze",
          "group": "2_tools@4"
        },
        {
          "command": "sayaib.hue-console.base64Encoder",
          "group": "2_tools@5",
          "when": "editorHasSelection"
        },
        {
          "command": "sayaib.hue-console.jwtDecoder",
          "group": "2_tools@6",
          "when": "editorHasSelection"
        },
        {
          "command": "sayaib.hue-console.yamlJsonTool",
          "group": "2_tools@7",
          "when": "editorLangId =~ /^(yaml|json|jsonc|dockercompose)$/"
        },
        {
          "command": "sayaib.hue-console.jsonToTypes",
          "group": "2_tools@8",
          "when": "editorLangId =~ /^(json|jsonc)$/"
        },
        {
          "command": "sayaib.hue-console.sparkSqlFormatter",
          "group": "2_tools@9",
          "when": "editorLangId == sql"
        },
        {
          "command": "sayaib.hue-console.dockerfileHelper",
          "group": "2_tools@10",
          "when": "editorLangId == dockerfile"
        },
        {
          "command": "sayaib.hue-console.envChecker",
          "group": "2_tools@11",
          "when": "resourceFilename =~ /^\\.env/"
        },
        {
          "command": "sayaib.hue-console.searchTools",
          "group": "3_search@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sayaib.hue-console.resetFeatureUsage",
          "when": "isDevelopment"
        }
      ]
    }
  },
  "activationEvents": [
    "onView:myView"
  ],
  "main": "./out/extention.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "compile:dev": "tsc -p ./ --incremental --tsBuildInfoFile .tsbuildinfo",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "test:unit": "node ./out/test/unit/run-unit-tests.js",
    "package": "vsce package",
    "vscode:prepublish": "node scripts/write-analytics-config.js && npm run compile"
  },
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/mocha": "^8.2.2",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^7.27.0",
    "glob": "^7.1.7",
    "mocha": "^12.0.1",
    "typescript": "^4.3.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "axios": "^1.8.3",
    "yaml": "^2.9.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DevSnip Pro scans workspace files and can run npm and OpenCode commands, so it requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Tools that spawn processes (OpenCode Integration) are unavailable in virtual workspaces."
    }
  }
}
