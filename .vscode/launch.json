{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Run Extension",
      "preLaunchTask": "npm: compile",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "--new-window"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    }
  ]
}
